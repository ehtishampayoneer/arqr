{
  "name": "arqr-site",
  "private": true,
  "version": "1.0.0",
  "description": "ARQR marketing site \u2014 one static page, no build step.",
  "scripts": {
    "images": "node build-images.js",
    "qr": "node qr-gen.js",
    "bump": "node bump-assets.js",
    "art": "node build-images.js && node bump-assets.js",
    "lang": "node build-lang.js",
    "shops": "node import-shop.js",
    "models": "node compress-models.js",
    "usdz": "node make-usdz.js",
    "restore": "node restore-models.js",
    "measure": "python measure-usdz.py && node measure-glb.js",
    "plan": "node plan-sizes.js",
    "sizes": "npm run measure && npm run plan && python fix-usdz-scale.py && node fix-glb-scale.js && npm run cards",
    "cards": "node card-sizes.js && node write-stores.js",
    "seo": "node seo.js",
    "brand": "node brand-images.js",
    "logo": "node logo-write.js"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "draco3dgltf": "^1.5.7",
    "jsqr": "^1.4.0",
    "meshoptimizer": "^1.2.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3"
  }
}
