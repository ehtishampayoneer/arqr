{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/r/:slug",
      "destination": "/api/r?slug=:slug"
    },
    {
      "source": "/admin",
      "destination": "/api/admin?p="
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/admin?p=:path*"
    },
    {
      "source": "/factory",
      "destination": "/api/factory?p="
    },
    {
      "source": "/factory/:path*",
      "destination": "/api/factory?p=:path*"
    },
    {
      "source": "/novara",
      "destination": "/store"
    },
    {
      "source": "/corso",
      "destination": "/store"
    },
    {
      "source": "/maison",
      "destination": "/store"
    },
    {
      "source": "/terra",
      "destination": "/store"
    },
    {
      "source": "/welcome",
      "destination": "/start"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/test/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/catalog",
      "destination": "/catalogue",
      "permanent": true
    }
  ],
  "functions": {
    "api/contact.js": {
      "maxDuration": 30
    },
    "api/ticket.js": {
      "maxDuration": 30
    },
    "api/paddle-webhook.js": {
      "maxDuration": 15
    },
    "api/admin.js": {
      "maxDuration": 30
    },
    "api/factory.js": {
      "maxDuration": 30
    }
  }
}
